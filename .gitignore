# your shoots and your photos: never in the repository
sesiones/
avatares/
pruebas/
entradas/

# library masters (4K, local) and caches
catalogo/_masters/
**/_mini/
catalogo/paquetes/u_*/

# SAM 3 scratch output (the script itself is kept)
sam3/*.jpg
sam3/*.png
sam3/t.json

# retired pre-fal library, kept on disk so old shoots still show their samples
catalogo/paquetes/accion_extrema/
catalogo/paquetes/accion_extrema_m/
catalogo/paquetes/paris/
catalogo/paquetes/paris_accion/
